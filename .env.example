# Supabase (Project Settings → API). Leave empty to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal (developer.paypal.com → Apps & Credentials). Leave empty to hide PayPal and cards.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id of the webhook pointing at /api/paypal/webhook.
PAYPAL_WEBHOOK_ID=
# `sandbox` (default) or `live`.
PAYPAL_ENV=sandbox

# Added in later phases: Resend (email), Twilio (SMS).

# Signs the guest basket cookie. Any random string of 32+ characters, e.g. `openssl rand -base64 32`.
BASKET_SECRET=
